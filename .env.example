NVIDIA_API_KEY="YOUR_NVIDIA_API_KEY_HERE"
DATABASE_URL="YOUR_DATABASE_URL_HERE"

# Comma-separated frontend origins allowed to call FastAPI.
CORS_ALLOW_ORIGINS="YOUR_CORS_ALLOW_ORIGINS_HERE"

# Optional regex for local dev origins on any port.
CORS_ALLOW_ORIGIN_REGEX="YOUR_CORS_ALLOW_ORIGIN_REGEX_HERE"

CORS_ALLOW_METHODS="YOUR_CORS_ALLOW_METHODS_HERE"
CORS_ALLOW_HEADERS="YOUR_CORS_ALLOW_HEADERS_HERE"
CORS_ALLOW_CREDENTIALS="YOUR_CORS_ALLOW_CREDENTIALS_HERE"